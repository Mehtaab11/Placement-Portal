# TPO Management System — Environment Variables
# Copy this file to .env.local and fill in your values

# ─── Database ───────────────────────────────────────────
# PostgreSQL connection string (local or Neon/Supabase cloud)
DATABASE_URL="postgresql://postgres:password@localhost:5432/tpo_db"

# ─── NextAuth ────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET="REPLACE_WITH_RANDOM_SECRET_32_CHARS_MIN"
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# ─── AI (Optional — Phase 10) ────────────────────────────
# Only needed if you want LLM-based resume feedback
# OPENAI_API_KEY=""
# GEMINI_API_KEY=""
